<?xml version="1.0"?>

<sdf version="1.9">


  <world name="ware_house">
  <!-- Physics System -->
  <plugin
    filename="gz-sim-physics-system"
    name="gz::sim::systems::Physics"/>

<!-- User Commands -->
  <plugin
    filename="gz-sim-user-commands-system"
    name="gz::sim::systems::UserCommands"/>

<!-- Scene Broadcaster -->
  <plugin
    filename="gz-sim-scene-broadcaster-system"
    name="gz::sim::systems::SceneBroadcaster"/>

<!-- Sensors System -->
  <plugin 
      filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
  </plugin>
  <plugin 
      filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  
    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gravity -->
    <gravity>0 0 -9.81</gravity>

    <!-- Built-in Models -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <!-- ========================= -->
    <!-- Front Wall -->
    <!-- ========================= -->

    <model name="front_wall">
      <pose>0 -10 1.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>10 0.2 3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>10 0.2 3</size>
            </box>
          </geometry>
        </collision>
        <inertial>
          <mass>10.0</mass>
          <inertia>
            <ixx>7.53</ixx>
            <iyy>90.83</iyy>
            <izz>83.37</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>
      </link>
    </model>

    <!-- ========================= -->
    <!-- Back Wall -->
    <!-- ========================= -->

    <model name="back_wall">
      <pose>0 5 1.5 0 0 0</pose>
