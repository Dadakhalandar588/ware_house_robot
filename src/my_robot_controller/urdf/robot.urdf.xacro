<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

  <xacro:property name="arm_length" value="2.0"/>
  <xacro:property name="arm_radius" value="0.04"/>
  <link name="world"/>

  <!-- Base Joint -->
  <joint name="base_joint" type="fixed">
    <origin xyz="1.5 1.0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- Base Link -->
  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="2.5 1.5 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="2.5 1.5 0.1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="12"/>
      <inertia
        ixx="2.26"
        ixy="0"
        ixz="0"
        iyy="6.26"
        iyz="0"
        izz="8.5"/>
    </inertial>

  </link>

  <!-- Slider Joint -->
  <joint name="slider_joint" type="prismatic">
    <origin xyz="-1.25 0 0.1" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="slider_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="2" effort="100" velocity="0.5"/>
  </joint>

  <!-- Slider Link -->
  <link name="slider_link">

    <visual>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <box size="1.5 1.5 0.15"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <box size="1.5 1.5 0.15"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <mass value="10"/>
      <inertia
        ixx="1.89"
        ixy="0"
        ixz="0"
        iyy="1.89"
        iyz="0"
        izz="3.75"/>
    </inertial>

  </link>

  <!-- Arm Joint -->
  <joint name="arm_joint" type="revolute">
    <origin xyz="-0.75 0 0.15" rpy="0 0 0"/>
    <parent link="slider_link"/>
    <child link="arm_link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="1.57" effort="100" velocity="1"/>
  </joint>

  <!-- Arm -->
  <link name="arm_link">

    <visual>
      <origin xyz="${arm_length/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder length="${arm_length}" radius="${arm_radius}"/>
      </geometry>
      <material name="orange">
        <color rgba="1 0.5 0 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="${arm_length/2} 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder length="${arm_length}" radius="${arm_radius}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="${arm_length/2} 0 0" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia
        ixx="0.5"
        ixy="0"
        ixz="0"
        iyy="0.5"
        iyz="0"
        izz="0.01"/>
    </inertial>

  </link>

  <!-- Camera Joint -->
  <joint name="camera_joint" type="fixed">
    <origin xyz="${arm_length} 0 ${arm_radius+0.075}" rpy="0 0 0"/>
    <parent link="arm_link"/>
    <child link="camera_link"/>
  </joint>

  <!-- Camera -->
  <link name="camera_link">

    <!-- Camera body -->
    <visual>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.15 0.15"/>
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <!-- Lens -->
    <visual>
      <origin xyz="0.06 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder length="0.06" radius="0.04"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

  </link>

</robot>
