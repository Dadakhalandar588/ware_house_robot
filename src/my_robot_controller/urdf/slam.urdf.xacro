<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="slam_robot">
  
  <xacro:property name="pi" value="3.14159265359"/>

  <!-- World -->
 
  <!-- Base -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.4 0.1"/>
      </geometry> 

      <material name="Dark Gray">
        <color rgba="0 0 1 1"/>
      </material>

    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.4 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5"/>
      <inertia
        ixx="0.0708"
        ixy="0"
        ixz="0"
        iyy="0.1083"
        iyz="0"
        izz="0.1708"/>
    </inertial>
  </link>

  <!-- Right Front Wheel -->

  <joint name="right_front_wheel_joint" type="continuous">
    <origin xyz="0.18 -0.22 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_front_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_front_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>

      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>

    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia
        ixx="0.001733"
        ixy="0"
        ixz="0"
        iyy="0.001733"
        iyz="0"
        izz="0.0032"/>
    </inertial>

  </link>

  <!-- Left Front Wheel -->

  <joint name="left_front_wheel_joint" type="continuous">
    <origin xyz="0.18 0.22 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_front_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="left_front_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>

      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>

    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia
        ixx="0.001733"
        ixy="0"
        ixz="0"
        iyy="0.001733"
        iyz="0"
        izz="0.0032"/>
    </inertial>

  </link>

  <!-- Right Rear Wheel -->

  <joint name="right_back_wheel_joint" type="continuous">
    <origin xyz="-0.18 -0.22 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_back_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_back_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>

      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>

    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia
        ixx="0.001733"
        ixy="0"
        ixz="0"
        iyy="0.001733"
        iyz="0"
        izz="0.0032"/>
    </inertial>

  </link>

  <!-- Left Rear Wheel -->

  <joint name="left_back_wheel_joint" type="continuous">
    <origin xyz="-0.18 0.22 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_back_wheel_link"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="left_back_wheel_link">

    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>

      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>

    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia
        ixx="0.001733"
        ixy="0"
        ixz="0"
        iyy="0.001733"
        iyz="0"
        izz="0.0032"/>
    </inertial>

  </link>
  
  <!-- Sliding Joint -->
<joint name="sliding_joint" type="prismatic">
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="sliding_link"/>

    <axis xyz="1 0 0"/>

    <limit
        lower="-0.20"
        upper="0.20"
        effort="100"
        velocity="0.2"/>
</joint>

<!-- Sliding Link -->
<link name="sliding_link">

    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <box size="0.35 0.30 0.10"/>
        </geometry>

        <material name="green">
            <color rgba="0 1 0 1"/>
        </material>
    </visual>

    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <box size="0.35 0.30 0.10"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="3"/>

        <inertia
            ixx="0.03125"
            ixy="0"
            ixz="0"
            iyy="0.03625"
            iyz="0"
            izz="0.06125"/>
    </inertial>

</link>
<joint name ="link1_joint" type ="revolute">
  <origin xyz = "0 0 0.05" rpy ="0 0 0"/>
  <parent link = "sliding_link"/>
  <child link = "link1"/>
  <axis xyz ="0 1 0"/>
  <limit lower="-1.57" upper = "0.008" effort = "100" velocity = "1"/>
</joint>
<!-- Link 1 -->
<link name="link1">

  <visual>
    <origin xyz="0.20 0 0" rpy="0 ${pi/2} 0"/>
    <geometry>
      <cylinder radius="0.03" length="0.40"/>
    </geometry>

    <material name="blue">
      <color rgba="0 0 1 1"/>
    </material>
  </visual>

  <collision>
    <origin xyz="0.20 0 0" rpy="0 ${pi/2} 0"/>
    <geometry>
      <cylinder radius="0.03" length="0.40"/>
    </geometry>
  </collision>

  <inertial>
    <origin xyz="0.20 0 0" rpy="0 0 0"/>
    <mass value="1"/>

    <inertia
      ixx="0.027"
      ixy="0"
      ixz="0"
      iyy="0.027"
      iyz="0"
      izz="0.0009"/>
  </inertial>

</link>

<!-- Revolute Joint 2 -->
<joint name="revolute2" type="revolute">

  <origin xyz="0.40 0 0" rpy="0 0 0"/>

  <parent link="link1"/>
  <child link="link2"/>

  <axis xyz="0 1 0"/>

  <limit
      lower="-0.059"
      upper="1.57"
      effort="100"
      velocity="1"/>

</joint>

<!-- Link 2 -->
<link name="link2">

  <visual>
    <origin xyz="0.15 0 0" rpy="0 ${pi/2} 0"/>
    <geometry>
      <cylinder radius="0.03" length="0.30"/>
    </geometry>

    <material name="Blue">
      <color rgba="1 0 0 1"/>
    </material>
  </visual>

  <collision>
    <origin xyz="0.15 0 0" rpy="0 ${pi/2} 0"/>
    <geometry>
      <cylinder radius="0.03" length="0.30"/>
    </geometry>
  </collision>

  <inertial>
    <origin xyz="0.15 0 0" rpy="0 0 0"/>
    <mass value="1"/>

    <inertia
      ixx="0.0115"
      ixy="0"
      ixz="0"
      iyy="0.0115"
      iyz="0"
      izz="0.000675"/>
  </inertial>

</link>
<!--wrist_joint_for_ee-->
<joint name = "wrist_joint" type = "revolute">
<origin xyz="0.28 0 0" rpy = "0 0 0"/>
<parent link ="link2"/>
<child link  = "wrist"/>
<axis xyz = "0 1 0"/>
<limit lower = "-1.57" upper="0.028" effort="100" velocity = "0.5"/>
</joint>
<!--vertical_link-->
<link name = "wrist">
   <visual>
      <origin xyz = "0 0 -0.05" rpy = "0 0 0 "/>
      <geometry>
        <box size = "0.05  0.25  0.06"/>
      </geometry>
      <material name ="black">
        <color rgba = "0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz = " 0 0 -0.05" rpy = "0 0 0"/>
      <geometry>
          <box size = "0.06  0.10  0.06"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz ="0 0 -0.05" rpy =" 0 0 0 "/>
      <mass value = "1"/>
      <inertia
        ixx="0.000454"
        ixy="0"
        ixz="0"
        iyy="0.000454"
        iyz="0"
        izz="0.000075"/>
    </inertial>
</link>
<!--finger joint-->
<joint name = "left_finger_joint" type = "prismatic">
<origin xyz="0 0.09 -0.05" rpy="0 0 0"/>
<parent link= "wrist"/>
<child link = "left_finger"/>
<axis xyz = "0 1 0"/>
<limit lower="0" upper="0.030" effort="100" velocity="1"/>
</joint>
<link name = "left_finger">
  <visual>
    <origin xyz="0 0 -0.06" rpy="0 0 0"/>
    <geometry>
      <box size = "0.020 0.025 0.15"/>
    </geometry>
    <material name="black">
      <color rgba = "0 0 1 1"/>
    </material>
  </visual>
  <collision>
    <origin xyz="0 0 -0.045" rpy="0 0 0"/>
    <geometry>
      <box size = "0.020 0.025 0.15"/>
    </geometry>
  </collision>
  <inertial>
     <origin xyz="0 0 -0.045" rpy="0 0 0"/>
     <mass value ="0.2"/>
     <inertia
        ixx="0.0001104"
        ixy="0"
        ixz="0"
        iyy="0.0001104"
        iyz="0"
        izz="0.0000075"/>
  </inertial>
</link>
<joint name = "right_finger_joint" type ="prismatic">
<origin xyz="0 -0.09 -0.05" rpy="0 0 0"/>
<parent link = "wrist"/>
<child link ="right_link"/>
<axis xyz="0 -1 0"/>
<limit lower="0" upper="0.030" effort="50" velocity="1"/>
</joint>
<link name="right_link">

    <visual>
        <origin xyz="0 0 -0.06" rpy="0 0 0"/>
        <geometry>
            <box size="0.020 0.025 0.15"/>
        </geometry>

        <material name="black">
            <color rgba="0 0 0 1"/>
        </material>
    </visual>

    <collision>
        <origin xyz="0 0 -0.06" rpy="0 0 0"/>
        <geometry>
            <box size="0.020 0.025 0.15"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 -0.06" rpy="0 0 0"/>

        <mass value="0.2"/>

        <inertia
            ixx="0.0001104"
            ixy="0"
            ixz="0"
            iyy="0.0001104"
            iyz="0"
            izz="0.0000075"/>
    </inertial>
</link>
<!--lidar_joint-->
<joint name="lidar_joint" type="fixed">
    <parent link="sliding_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
</joint>
<link name="lidar_link">

    <visual>
        <origin xyz="0.09 0.09 0" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.04" length="0.04"/>
        </geometry>

        <material name="Sliver">
            <color rgba="0.1 0.1 0.1 1"/>
        </material>
    </visual>

    <collision>
        <origin xyz="0.09 0.09 0.05" rpy="0 0 0"/>
        <geometry>
            <cylinder radius="0.04" length="0.04"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0.09 0.09 0.05" rpy="0 0 0"/>

        <mass value="0.3"/>

        <inertia
            ixx="0.00026"
            ixy="0"
            ixz="0"
            iyy="0.00026"
            iyz="0"
            izz="0.00024"/>
    </inertial>

</link>
<joint name="camera_joint" type="fixed">
    <parent link="sliding_link"/>
    <child link="camera_link"/>
    <origin xyz="0.20 -0.05 0.05" rpy = " 0 0 0" />
</joint>
<link name="camera_link">

    <!-- Visual -->
    <visual>
        <origin xyz="0 0 0" rpy="0 0.25 0"/>
        <geometry>
            <box size="0.08 0.03 0.03"/>
        </geometry>
        <material name="camera_black">
            <color rgba="0.15 0.15 0.15 1"/>
        </material>
    </visual>

    <!-- Collision -->
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <box size="0.08 0.03 0.03"/>
        </geometry>
    </collision>
   <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.25"/>
    <inertia
        ixx="0.0002"
        ixy="0"
        ixz="0"
        iyy="0.0002"
        iyz="0"
        izz="0.0002"/>
</inertial>
</link>
<joint name = "imu" type = "fixed">
<origin xyz = "-0.10 -0.05 0.05" rpy = "0 0 0"/>
<parent link = "sliding_link"/>
<child link  = "imu_link"/>
</joint>
<link name = "imu_link">
  <visual>
    <origin xyz = "0 0 0" rpy = " 0 0 0 "/>
    <geometry>
      <cylinder length="0.06" radius="0.045"/>
    </geometry>
    <material name="steel">
      <color rgba="0.35 0.35 0.35 1"/>
    </material>
  </visual>
  <collision>
     <origin xyz = "0 0 0" rpy = " 0 0 0 "/>
    <geometry>
      <cylinder length="0.06" radius="0.045"/>
    </geometry>
  </collision>
  <inertial>
    <origin xyz ="0 0 0" rpy = " 0 0 0"/>
    <mass value = "0.20"/>
    <inertia 
     ixx="0.000073"
      ixy="0.0"
      ixz="0.0"
      iyy="0.000073"
      iyz="0.0"
      izz="0.000063"/>
  </inertial>
</link>
<!--camera _sensor-->
<gazebo reference="camera_link">

  <sensor name="camera_sensor" type="camera">

    <update_rate>30</update_rate>

    <camera>

      <horizontal_fov>1.047</horizontal_fov>

      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>

      <clip>
        <near>0.1</near>
        <far>100</far>
      </clip>

    </camera>

    <visualize>true</visualize>

  </sensor>

</gazebo>
<!-- ======================= LIDAR ======================= -->
<gazebo reference="lidar_link">
  <sensor name="lidar_sensor" type="gpu_lidar">
    <always_on>true</always_on>
    <update_rate>20</update_rate>
    <visualize>true</visualize>
    <topic>/scan</topic>
    <frame_id>lidar_link</frame_id>
    <gz_frame_id>lidar_link</gz_frame_id>
    <lidar>
      <scan>
        <horizontal>
          <samples>720</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.15</min>
        <max>15.0</max>
        <resolution>0.01</resolution> 
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.005</stddev>
      </noise>
    </lidar>
  </sensor>
</gazebo>


<!-- ========================= IMU ========================= -->
<gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <topic>imu</topic>
    <imu>
      <angular_velocity>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0002</stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0002</stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0002</stddev>
          </noise>
        </z>
      </angular_velocity>
      <linear_acceleration>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.017</stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.017</stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.017</stddev>
          </noise>
        </z>
      </linear_acceleration>
    </imu>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  </sensor>
</gazebo>
<gazebo>
  <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
    <left_joint>left_front_wheel_joint</left_joint>
    <left_joint>left_back_wheel_joint</left_joint>
    <right_joint>right_front_wheel_joint</right_joint>
    <right_joint>right_back_wheel_joint</right_joint>
    <wheel_separation>0.44</wheel_separation>
    <wheel_radius>0.08</wheel_radius>
    <topic>cmd_vel</topic>
    <odom_topic>odom</odom_topic>
    <frame_id>odom</frame_id>
    <child_frame_id>base_link</child_frame_id>
    <tf_topic>tf</tf_topic>
  </plugin>
</gazebo>
<gazebo>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>sliding_joint</joint_name>
    <p_gain>50</p_gain>
    <i_gain>0</i_gain>
    <d_gain>5</d_gain>
    <topic>sliding_joint_cmd</topic>
  </plugin>
</gazebo>

<gazebo>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>link1_joint</joint_name>
    <p_gain>50</p_gain>
    <i_gain>0</i_gain>
    <d_gain>5</d_gain>
    <topic>link1_joint_cmd</topic>
  </plugin>
</gazebo>

<gazebo>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>revolute2</joint_name>
    <p_gain>50</p_gain>
    <i_gain>0</i_gain>
    <d_gain>5</d_gain>
    <topic>revolute2_cmd</topic>
  </plugin>
</gazebo>

<gazebo>
  <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
    <joint_name>wrist_joint</joint_name>
    <p_gain>50</p_gain>
    <i_gain>0</i_gain>
    <d_gain>5</d_gain>
    <topic>wrist_joint_cmd</topic>
  </plugin>
</gazebo>
<gazebo>
  <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
  </plugin>
</gazebo>
</robot>